-- Global Theme Update Engine
local function UpdateUIColors(newColor)
    _G.AimbotConfig.ThemeColor = newColor
    UICircleStroke.Color = newColor
    ReopenButton.BackgroundColor3 = newColor
    
    for _, item in ipairs(Container:GetChildren()) do
        if item:IsA("Frame") and item:FindFirstChild("IsSlider") then
            item.Track.Fill.BackgroundColor3 = newColor
        elseif item:IsA("Frame") and item:FindFirstChild("ConfigKey") then
            local key = item.ConfigKey.Value
            if _G.AimbotConfig[key] then
                item.SwitchBase.BackgroundColor3 = newColor
            end
        end
    end
end

