-- Core Target Lock Processing Algorithm
local function getClosestPlayer()
    local closest, dist = nil, math.huge
    local sizeX = Camera.ViewportSize.X
    local sizeY = Camera.ViewportSize.Y
    if sizeX <= 0 or sizeY <= 0 then return nil end

    local mousePos = Vector2.new(sizeX / 2, sizeY / 2)
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or not plr.Character then continue end
        
        local head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
        local humanoid = plr.Character:FindFirstChildOfClass("Humanoid")
        if not head or (humanoid and humanoid.Health <= 0) then continue end

        if _G.AimbotConfig.TeamCheck and plr.Team == LocalPlayer.Team then continue end
        if _G.AimbotConfig.FriendsCheck and LocalPlayer:IsFriendsWith(plr.UserId) then continue end

        local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        if not onScreen then continue end

        local distance = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if distance > _G.AimbotConfig.FovSize then continue end

        if _G.AimbotConfig.VisibleCheck then
            local parts = Camera:GetPartsObscuringTarget({head.Position}, {LocalPlayer.Character, plr.Character})
            if #parts > 0 then continue end
        end

        if distance < dist then
            dist = distance
            closest = plr
        end
    end
    return closest
end

-- Render Frame Main Loop
RunService.RenderStepped:Connect(function()
    local sizeX = Camera.ViewportSize.X
    local sizeY = Camera.ViewportSize.Y
    if sizeX <= 0 or sizeY <= 0 then return end
    
    local midX = sizeX / 2
    local midY = sizeY / 2
    UICircleFrame.Position = UDim2.new(0, midX, 0, midY)

    if not _G.AimbotConfig.Enabled then return end

    local target = getClosestPlayer()
    if target and target.Character and target.Character:FindFirstChild("Head") then
        local head = target.Character.Head
        local headPos = head.Position
        
        -- Smooth look vector updates
        local direction = (headPos - Camera.CFrame.Position).Unit
        local current = Camera.CFrame.LookVector
        local weight = math.clamp(_G.AimbotConfig.Smoothing, 0.01, 1.0)
        local smoothed = current:Lerp(direction, weight)
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position +
